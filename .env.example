# provisioning/New-AuthFlowTenant.ps1 writes .env for you. If you created the resources by hand,
# copy this file to .env at the repo root and fill it in. Never commit .env.

PORT=5100
TENANT_ID=00000000-0000-0000-0000-000000000000

# The SPA client. It signs users in with auth code + PKCE and doubles as the public client for device code.
# Register http://localhost:5100/auth-callback as a SPA redirect URI.
SPA_CLIENT_ID=

# The middle-tier API. Exposes api://<API_CLIENT_ID>/access_as_user and calls Graph with classic OBO.
API_CLIENT_ID=
API_CLIENT_SECRET=

# The daemon for client credentials. Fill in the secret, the certificate or both.
# Certificate paths can be absolute or relative to the repo root, and both files are PEM.
DAEMON_CLIENT_ID=
DAEMON_CLIENT_SECRET=
DAEMON_CERT_PATH=
DAEMON_KEY_PATH=

# The confidential web app. It signs users in with auth code + PKCE and redeems the code on the server.
# Register http://localhost:5100/webapp/callback as a Web redirect URI.
# Fill in the secret, the certificate or both. Certificate paths work like the daemon's.
WEBAPP_CLIENT_ID=
WEBAPP_CLIENT_SECRET=
WEBAPP_CERT_PATH=
WEBAPP_KEY_PATH=

# The MCP server. Exposes api://<MCP_CLIENT_ID>/mcp.tools and calls Graph with OBO.
MCP_CLIENT_ID=
MCP_CLIENT_SECRET=

# Entra Agent ID. The blueprint exposes api://<BLUEPRINT_APP_ID>/access_as_user.
BLUEPRINT_APP_ID=
BLUEPRINT_CLIENT_SECRET=
AGENT_IDENTITY_APP_ID=

# Conditional Access What If subjects. Use object IDs, not app IDs.
# DEMO_USER_ID is the demo user, DAEMON_SP_ID is the daemon's service principal
# and AGENT_IDENTITY_SP_ID is the agent identity's service principal.
# The daemon app needs the Policy.Read.ConditionalAccess application permission.
DEMO_USER_ID=
DAEMON_SP_ID=
AGENT_IDENTITY_SP_ID=

# Step-up with a Conditional Access authentication context. The API demands this acrs value.
# STEPUP_AUTH_CONTEXT defaults to c1. Set STEPUP_ENABLED=true to turn on the step-up endpoint.
STEPUP_AUTH_CONTEXT=c1
STEPUP_ENABLED=
